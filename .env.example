# Ezri Africa — sandbox keys (never commit real values)
# PayPal sandbox app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Database Connection (Prisma Postgres / PostgreSQL) — real value goes in
# Render dashboard / local .env only, NEVER committed.
DATABASE_URL=

# Upstash Redis Caching & Rate Limiting
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 Object Storage (Receipt Photo Proofs)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# Any LLM via OpenRouter (DeepSeek Flash for chat, Qwen for vision)
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Ezri Africa hackathon demo

# Demo expiry minutes (10 in demo, stands for 48h production)
DEMO_EXPIRY_MINUTES=10

# API base for web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
