# Ezri Africa -- environment template.
#
# This file is committed. Real values are NOT.
#   API gateway keys:  copy to `.env` in this directory
#   Web/Next.js keys:  copy `web/.env.example` to `web/.env.local`
#
# Render injects production values from the dashboard. Locally, python-dotenv
# fills only MISSING variables (process env always wins). With zero keys the
# whole app still runs in demo mode: mock PayPal, SQLite, heuristic AI guard,
# and an in-process cache.

# ---------------------------------------------------------------------------
# Gateway / API
# ---------------------------------------------------------------------------
# Demo expiry: 10 minutes on stage; production policy is 48 hours.
DEMO_EXPIRY_MINUTES=10
# Platform fee (0.02 = 2%), charged on top of the transfer amount.
EZRI_FEE_PCT=0.02
# PIN for MCP money-moving tools (the web chat uses 1234 in demo mode).
EZRI_MONEY_PIN=1234
# Origin used inside password-reset links delivered to the notify webhook.
WEB_BASE_URL=https://ezri-africa.com
# Comma-separated CORS allowlist (no spaces). Leave unset for the production
# defaults baked into the code; set it locally to allow the dev server.
# CORS_ALLOWED_ORIGINS=https://ezri-africa.com,https://www.ezri-africa.com,https://ezri-africa.onrender.com

# ---------------------------------------------------------------------------
# Dual database (leave blank to use SQLite at api/ezri.db)
# ---------------------------------------------------------------------------
# Primary: Neon / Postgres connection string (pooled). Neon must end with
# ?sslmode=require. Without it, data is wiped on every Render redeploy.
DATABASE_URL=
# Optional: direct (non-pooled) Neon URL used only for schema initialization.
# Neon CLI writes this automatically as DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED=
# Secondary: a second, independent Postgres (for example Prisma Postgres).
# Reads fail over automatically; writes are mirrored to both while healthy.
DATABASE_URL_SECONDARY=
# Optional direct URL for secondary schema initialization. Falls back to the
# pooled DATABASE_URL_SECONDARY (Prisma Postgres only exposes a pooled URL).
DATABASE_URL_SECONDARY_UNPOOLED=
# Resilience tuning.
DB_MIRROR_WRITES=true
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=3000
DB_INIT_TIMEOUT=15
DB_INIT_TIMEOUT_MS=15000
DB_FAILURE_COOLDOWN_SECONDS=30
DB_SLOW_MS=3000
DB_POOL_MIN=1
DB_POOL_MAX=5
# Optional override for the local SQLite file path.
# EZRI_DB=api/ezri.db

# ---------------------------------------------------------------------------
# Upstash Redis read cache (blank = in-process memory fallback)
# ---------------------------------------------------------------------------
# Create a free Redis DB at https://console.upstash.com/redis, then copy the
# REST URL + REST token from the database's "REST API" section. The cache sits
# in front of every ledger read; a cache outage fails open to Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DB_CACHE_ENABLED=true
DB_READ_CACHE_TTL=30
SESSION_CACHE_TTL=600
USER_CACHE_TTL=60

# ---------------------------------------------------------------------------
# PayPal sandbox (leave both blank for deterministic mock mode)
# ---------------------------------------------------------------------------
# Create an app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# AI (leave OPENROUTER_API_KEY blank for the heuristic guard)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Comma-separated fallback chain. If the first model is rate-limited upstream,
# the next one is tried before falling back to the deterministic rules.
OPENROUTER_MODELS=deepseek/deepseek-chat,qwen/qwen-2.5-72b-instruct
OPENROUTER_SITE_URL=https://ezri-africa.com
OPENROUTER_SITE_NAME=Ezri Africa hackathon demo

# ---------------------------------------------------------------------------
# Automation / Zapier (leave blank to disable outbound webhooks)
# ---------------------------------------------------------------------------
# Zapier "Catch Hook" URL. Every lifecycle event POSTs there, including
# auth.otp_requested (carries the sign-in code) and auth.reset_requested
# (carries the reset link), so Zapier can send real email/SMS.
NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Web (Next.js) -- use web/.env.example -> web/.env.local instead of this file
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://api.ezri-africa.com
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ---------------------------------------------------------------------------
# Reserved infrastructure (present in older configs; not read by current code)
# ---------------------------------------------------------------------------
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
