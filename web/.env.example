# Web environment template -- copy to web/.env.local (gitignored).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build/dev start:
# restart `pnpm dev` (or rebuild) after changing them.
#
# Production value (the default):
NEXT_PUBLIC_API_URL=https://api.ezri-africa.com
# For local development, set this to your local gateway origin (port 8000)
# in web/.env.local; the dev server runs on port 3000.

# Optional: browser-side PayPal buttons. Blank keeps the mock checkout path.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
